includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Self-contained games keep their config next to their code.
    configDirectories:
        - %currentWorkingDirectory%/config
        - %currentWorkingDirectory%/app/Games/*/config

    parseModelCastsMethod: true
