  "claims": [
    {
      "text": "Narration recalls that he was captured and put into a prison. He feigned madness, smeared his own stool onto his body, cut off his fifth limb, and became a eunuch. His enemies believed he had gone crazy, loosened their vigilance, and gave him a chance to flee. He later returned to take revenge and massacred his enemies’ whole family, including the old and the young.",
      "chapters": [
        228
      ],
      "certainty": "canon",
      "confidence": "B",
      "verification": "citation_unchecked",
      "source_id": "src_sagaofgu",
      "section": "intro",
      "text_origin": "source_excerpt"
    },
    {
      "text": "The same stretch places him among historical figures who bided their time and were not attached to fleshly appearance.",
