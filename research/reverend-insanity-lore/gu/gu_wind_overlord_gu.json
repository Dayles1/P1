  "history": {
    "claims": [
      {
        "text": "After injuries from four arm earth king heal, Fang Yuan changes earth overlord Gu to wind overlord Gu and adjusts the other supplementary Gu worms.",
        "chapters": [
          546
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "gu_earth_overlord_gu"
        ]
      },
      {
        "text": "With that change he no longer needs to step on the ground and fights best in the wind. Stronger wind raises the battle strength he can show and shrinks the drawbacks after the killer move. Without wind the consequences of using the killer move are no better than before, and Gu Masters have many ways to restrict wind.",
        "chapters": [
          546
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "in-four-arm-wind-king",
        "text_origin": "source_excerpt",
        "mentions": [
          "fac_gu_masters"
        ]
      },
      {
        "text": "Fang Yuan names the killer move four arm wind king and says it uses wind overlord Gu and tyrant strength Gu as a substitute for borrow strength Gu, at under half the effect.",
        "chapters": [
          560
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "with-tyrant-strength-gu",
        "text_origin": "source_excerpt",
        "mentions": [
