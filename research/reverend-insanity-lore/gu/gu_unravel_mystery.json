  "history": {
    "claims": [
      {
        "text": "Fang Yuan wants that Gu as the core of a dream path immortal killer move from his memories. Through a three-party deal with Heavenly Lord Bai Zu and the seller, Fang Yuan obtains Unravel Mystery while Bai Zu takes the recipe; few people know the Gu has changed hands.",
        "chapters": [
          763
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "fac_bai_zu_tribe"
        ]
      },
      {
        "text": "Fang Yuan modifies star fog concealment with the light of wisdom, and in the modified move Unravel Mystery replaces the second of its two core Immortal Gu beside Star Thought Immortal Gu. By then his wisdom path attainment is grandmaster, and the Gu he could not use well before starts to display its capabilities.",
        "chapters": [
          987
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "star-fog-concealment-core",
        "text_origin": "source_excerpt",
        "mentions": [
          "gu_star_thought_immortal_gu"
        ]
      }
    ]
