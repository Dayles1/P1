  "abilities": {
    "activation_raw": null,
    "claims": [
      {
        "text": "After refining enough dream path mortal Gu in Hu Immortal blessed land, Fang Yuan uses Unravel Mystery as the core and forms the immortal killer move Unravel Dream. Activating the move ends with green grape immortal essence and Unravel Mystery; light from the Gu converts through the dream path Gu formation into green-purple light in his pupils.",
        "chapters": [
          773
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "dream-path-killer-move",
        "text_origin": "source_excerpt",
        "mentions": [
          "loc_hu_immortal_blessed_land"
        ]
      },
      {
        "text": "Unravel Mystery can be used repeatedly in that setup, but the supplementary dream path mortal Gu are expended with continuous use.",
        "chapters": [
          915
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "dream-path-killer-move",
        "text_origin": "source_excerpt"
      },
      {
        "text": "The move uses Unravel Mystery as a wisdom path core in place of a dream path Immortal Gu, so each use burns many dream path mortal Gu.",
        "chapters": [
          763
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "dream-path-killer-move",
        "text_origin": "source_excerpt"
      },
      {
        "text": "Its effect is to help a Gu Immortal think and solve puzzles and mysteries. Against a battlefield killer move treated as a puzzle, the Gu would be helpful in principle, but alone it cannot unravel such moves.",
        "chapters": [
          904
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "puzzles-and-battlefield-moves",
        "text_origin": "source_excerpt"
      }
    ]
  },
