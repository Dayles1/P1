    "related_variants": [],
    "claims": [
      {
        "text": "A Gu formation that uses the light of wisdom, Mo Yao’s fake will, Woman’s Heart, and Unravel Mystery refines Bo Qing’s Immortal Gu.",
        "chapters": [
          997
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wisdom-refinement-and-later-use",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_mo_yao",
          "gu_womans_heart",
          "char_bo_qing"
        ]
      },
      {
        "text": "Fang Yuan later names that arrangement the wisdom refinement formation, with Woman’s Heart and Unravel Mystery as cores plus large numbers of supplementary mortal Gu.",
        "chapters": [
          1083
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wisdom-refinement-and-later-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "For a stretch it is Fang Yuan’s only wisdom path Immortal Gu, and without matching wisdom path killer moves it has little use on its own.",
        "chapters": [
          1232
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wisdom-refinement-and-later-use",
        "text_origin": "source_excerpt"
      },
      {
        "text": "An inventory from that later period lists Unravel Mystery among his rank six Immortal Gu.",
        "chapters": [
          1461
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "wisdom-refinement-and-later-use",
        "text_origin": "source_excerpt"
      }
    ]
  },
