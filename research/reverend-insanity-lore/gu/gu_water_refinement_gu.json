  "history": {
    "claims": [
      {
        "text": "When Fang Yuan annexes Lang Ya blessed land he obtains the Long Hair refinement path true inheritance and many Immortal Gu. There had originally been three rank eight Immortal Gu, Water Refinement, Forceful Refinement, and Advance Refinement, but Shadow Sect had stolen Forceful Refinement in an earlier battle. All three are refinement path Immortal Gu. Used alone they have no offensive power and are all support type.",
        "chapters": [
          1767
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
        "mentions": [
          "char_fang_yuan",
          "loc_lang_ya_blessed_land",
          "gu_forceful_refinement_gu",
          "gu_advance_refinement_gu",
          "fac_shadow_sect"
        ]
      },
      {
        "text": "The rank eight water refinement Immortal Gu was hidden within the refinement water. Lang Ya land spirit had been using this Gu and other supplementary Gu worms to form an immortal killer move that converts the refinement path and water path dao marks of Lang Ya blessed land into refinement water, aiming to accumulate a Refinement Sea. After annexing the blessed land, Fang Yuan takes the Gu out for his own use.",
        "chapters": [
          1767
        ],
        "certainty": "canon",
        "confidence": "B",
        "verification": "citation_unchecked",
        "source_id": "src_sagaofgu",
        "section": "intro",
        "text_origin": "source_excerpt",
